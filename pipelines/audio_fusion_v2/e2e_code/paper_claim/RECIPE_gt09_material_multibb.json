  "data": {
    "group_column": "specimen_group",
    "hand_source": "cached_paths_y_features",
    "robot_source": "cached_paths_y_features_after_lock_only",
    "note": "Raw tree_structures may be offline; features/paths/y caches are identity-aligned."
  },
  "frozen_contact_stack": {
    "primary": {"ts_th": 0.5, "cs_th": 0.1},
