    "hand_y": "outputs/audio_feature_benchmarks/total240_trainval_select/features/hand_train_full/y.npy",
    "robot_audio_paths": "outputs/audio_feature_benchmarks/total240_trainval_select/features/robot_test/paths.npy",
    "robot_y": "outputs/audio_feature_benchmarks/total240_trainval_select/features/robot_test/y.npy"
