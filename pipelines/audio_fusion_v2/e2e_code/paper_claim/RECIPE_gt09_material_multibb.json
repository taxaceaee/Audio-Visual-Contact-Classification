      "cascade_views": [[0.0, 0.0], [0.35, 0.0], [0.0, 0.35], [0.25, 0.25]],
      "cascade_gain_eval": [0.3, 0.3],
      "eligible": {
        "casc_gain_min": 0.01,
        "clean_macro_min": 0.93,
        "trunk_rec_drop_max": 0.03,
        "false_trunk_max": 15,
        "nflip_min": 1
