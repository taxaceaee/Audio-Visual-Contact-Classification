{
  "recipe_id": "paper_claim_v2_simple_leaf_bias",
  "version": 2,
  "claim_type": "pure_single_shot_locked_recipe",
  "description": "Simplified multimodal claim: v2 + stress amb-lift + secondary CLIP trunk + single leaf logit bias (protect-trunk) on meta soft. All free HPs selected on hand only under pre-registered 1-D cascade ranking. Robot opened at most once after lock.",
  "data": {
    "selection_split": "hand_train",
    "selection_dataset": "audio_visual_dataset_default",
    "test_split": "robot_test",
    "test_dataset": "audio_visual_dataset_robo_default",
    "group_column": "specimen_group",
    "group_definition": "audio stem with _window_* and _segment_* stripped; never parse class tokens from filename"
  },
  "forbidden": {
    "robot_in_selection": true,
    "filename_class_features": true,
    "robot_uda": true,
    "test_hp_tuning": true,
    "multi_open_robot_for_claim": true,
    "choose_best_of_n_robot_runs": true
  },
  "frozen_contact_stack": {
    "note": "Frozen constants from prior HAND-ONLY selection (stress amb-lift + collapse-gain secondary). Not re-searched here. Not fit on robot. do_tt intentionally DISABLED (simplification).",
    "source_locks": [
      "outputs/audio_feature_benchmarks/multimodal_085_collapse_secondary_group_selection/selection_lock.json"
    ],
    "primary": {
      "ts_th": 0.5,
      "cs_th": 0.1,
      "do_tt": false
    },
    "secondary": {
      "img_th": 0.625,
      "img_cs": 0.75
    },
    "base_rule": "hier_trunk_meta_else on v2 segment artifact"
  },
  "material_decode": {
    "mode": "protect_trunk_leaf_bias_only",
    "soft_source": "meta",
    "T": 1.0,
    "b_trunk": 0.0,
    "b_twig": 0.0,
    "apply_only_when_pred_in": [1, 3],
    "protect_classes": [2],
    "free_params": ["b_leaf"],
    "selection_rule": {
      "name": "cascade_gain_1d_leaf_bias",
      "pre_registered": true,
      "eligible": {
        "casc_gain_min": 0.015,
        "clean_macro_min": 0.94,
        "nflip_min": 1,
        "trunk_rec_drop_max": 0.02,
        "false_trunk_max": 12
      },
      "rank_keys_desc": ["casc_gain", "clean", "twig_rec"],
      "fallback_if_none_eligible": "identity_no_material_change",
      "cascade_views": [
        [0.0, 0.0],
        [0.35, 0.35],
        [0.5, 0.4]
      ],
      "cascade_gain_eval": [0.45, 0.4],
      "cv": {
        "n_splits": 5,
        "shuffle": true,
        "random_state": 42,
        "type": "StratifiedGroupKFold"
      },
      "grid": {
        "b_leaf": "linspace(-2.0, 0.5, 26)"
      }
    }
  },
  "artifacts": {
    "hand_oof_bundle": "outputs/audio_feature_benchmarks/multimodal_085_material_logit_bias_group_selection/hand_oof_bundle.npz",
    "v2_robot_base": "outputs/audio_feature_benchmarks/segment_rule_stack_v2_group_selection/segment_rule_stack_v2_base_segment_outputs.npz",
    "claim_out": "outputs/paper_claim_v2"
  },
  "simplification_vs_v1": [
    "no do_tt / no trunk-vs-twig audio detector",
    "no b_trunk / b_twig free params",
    "T fixed to 1.0",
    "soft source = meta only (not v2_rule_soft)",
    "1-D hand grid on b_leaf only"
  ],
  "honesty_note": "Prior exploratory peeks and paper_claim_v1 are outside this claim directory. This path enforces one sealed robot open under a frozen simplified recipe."
}
